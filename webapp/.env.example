# 复制成 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录的 .env 做变量替换

# ---------- 必填：爱快路由器 ----------
IKUAI_URL=192.168.123.1
IKUAI_USER=admin
IKUAI_PASS=你的爱快登录密码

# ---------- 建议填：网页访问认证（留空 = 不认证，务必只在内网暴露）----------
AUTH_USER=admin
AUTH_PASS=你自己设一个访问密码

# ---------- 可选 ----------
# 飞牛上的对外端口
WEB_PORT=8088
# 等待镜像下载完成的最长秒数（默认 900 = 15 分钟）。
# 这只是初始值；页面上「设置 → 等待镜像下载完成的最长秒数」改过的值
# 会写进容器卷里的 /data/settings.json，并**优先于这里**。
# 大镜像（上 GB）建议 1800 ~ 3600。
PULL_TIMEOUT=1800
# 1 = 干跑模式，只演练不真正改容器（定时任务同样会变成只演练）
DRY_RUN=0
# 【仅兜底】上游版本检测用的加速源，逗号分隔，按顺序回退。
# 正常情况下用不到：检测会自动读取「爱快 Docker 服务设置里的加速源」，
# 保证「检测的源」和「爱快实际拉取的源」一致。
# 只有在读爱快配置失败、或爱快没配加速源时，才回退到这里。
# 所以想换加速源，应该去爱快后台改，而不是改这里。
REGISTRIES=https://docker.1ms.run,https://hub.rat.dev,https://docker.m.daocloud.io

# ---------- 仅在「构建时拉不到 docker.io」才需要改 ----------
# 构建镜像的基础镜像。默认走官方 docker.io；
# 若飞牛报 "failed to resolve source metadata for docker.io/library/python:3.13-alpine"，
# 把它换成任一可用的镜像源前缀即可（下面这行就是可用的）：
BASE_IMAGE=docker.1ms.run/library/python:3.13-alpine
# 其他备选：
#   docker.m.daocloud.io/library/python:3.13-alpine
#   hub.rat.dev/library/python:3.13-alpine
